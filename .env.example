# PostgreSQL (used by docker-compose and the API)
POSTGRES_DB=bitown
POSTGRES_USER=bitown
POSTGRES_PASSWORD=change-this-password

# Go API
DATABASE_URL=postgres://bitown:change-this-password@postgres:5432/bitown?sslmode=disable
REDIS_URL=redis://redis:6379
SUPABASE_JWT_SECRET=dev-secret-not-used-in-local
SUPABASE_URL=https://placeholder.supabase.co
ENV=development
DAILY_SALT_SEED=change-this-to-a-random-secret
PORT=8080
# Repo-root assets directory (docker-compose sets /assets automatically)
BITOWN_ASSETS_DIR=
# When true (or ENV=production), map.png fails instead of rectangle fallback without atlas
BITOWN_ATLAS_REQUIRED=
# Leave empty for dev (allows *). Set to your domain in production, e.g. https://bitown.dev
CORS_ALLOW_ORIGIN=
